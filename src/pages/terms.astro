---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const updated = "February 2026";
---

<Layout
  title="Terms of Service | Furum Consulting"
  description="The terms that govern use of the Furum Consulting website and services."
  noindex={true}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1>Terms of service</h1>
      <p>Last updated: {updated}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <p>
          These Terms govern your use of the Furum Consulting website. By
          accessing or using the site, you agree to these Terms. If you do not
          agree, please do not use the site.
        </p>

        <h2>Use of the website</h2>
        <p>
          The content on this site is provided for general information only. You
          agree not to misuse the site, interfere with its normal operation, or
          use it for any unlawful purpose.
        </p>

        <h2>Services</h2>
        <p>
          Our services are provided under a separate written agreement. Any
          figures, examples, or illustrative models shown on this website are for
          information only and are not a guarantee of results. Actual outcomes
          depend on factors specific to your business, niche, and market.
        </p>

        <h2>Intellectual property</h2>
        <p>
          All content on this website, including text, branding, and design, is
          owned by or licensed to Furum Consulting and may not be copied or
          reproduced without our prior written permission.
        </p>

        <h2>Third-party links</h2>
        <p>
          Our website may link to third-party sites and tools. We are not
          responsible for the content or practices of those third parties, and
          links do not imply our endorsement.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the fullest extent permitted by law, Furum Consulting is not liable
          for any indirect, incidental, or consequential loss arising from your
          use of this website. Nothing in these Terms limits any liability that
          cannot be limited under applicable law.
        </p>

        <h2>Changes to these Terms</h2>
        <p>
          We may update these Terms from time to time. Continued use of the site
          after changes are posted means you accept the updated Terms.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about these Terms? Contact us at
          <a href="mailto:contact@furumconsulting.com">contact@furumconsulting.com</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
