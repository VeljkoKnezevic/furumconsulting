---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const updated = "[Month YYYY — placeholder]";
---

<Layout
  title="Terms of Service | Furum Consulting"
  description="The terms that govern use of the Furum Consulting website and services."
  noindex={true}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1>Terms of service</h1>
      <p>Last updated: {updated}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <p class="placeholder-note">
          [PLACEHOLDER — template copy, not legal advice. Have it reviewed and
          completed by a qualified professional before publishing. Specific
          engagement terms are set out in your individual service agreement.]
        </p>

        <p>
          These Terms govern your use of the Furum Consulting website. By using
          the site, you agree to them.
        </p>

        <h2>Use of the website</h2>
        <p>
          The content on this site is provided for general information. You agree
          not to misuse the site or use it for any unlawful purpose.
        </p>

        <h2>Services</h2>
        <p>
          [Placeholder] Our services are provided under a separate written
          agreement. Any figures, examples, or illustrative models shown on this
          website are for information only and are not a guarantee of results.
        </p>

        <h2>Intellectual property</h2>
        <p>
          All content on this website, including text, branding, and design, is
          owned by or licensed to Furum Consulting and may not be reproduced
          without permission.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          [Placeholder] To the fullest extent permitted by law, Furum Consulting
          is not liable for any indirect or consequential loss arising from use of
          this website. Complete this section with your counsel.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about these Terms? Contact us at
          <a href="mailto:hello@furumconsulting.com">hello@furumconsulting.com</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
