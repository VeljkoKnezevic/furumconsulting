---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">For recruiting agency owners</p>
      <h1>Predictable client acquisition for recruiting agencies.</h1>
      <p class="hero-lede">
        We build and run the outbound that puts qualified hiring-manager
        conversations on your calendar. No cold calling, no chasing, no BD hire
        &mdash; and you only pay when it works.
      </p>
      <div class="hero-actions">
        <a href="/book" class="btn btn-primary btn-lg">Book a call</a>
        <a href="/how-it-works" class="btn btn-outline btn-lg">See how it works</a>
      </div>
    </div>
  </section>

  <!-- Risk reversal band: the centerpiece -->
  <section class="risk section--alt">
    <div class="container risk-inner">
      <p class="eyebrow">Our model</p>
      <h2>You don&rsquo;t pay unless we deliver.</h2>
      <p>
        We work on a pay-on-results basis. You&rsquo;re not buying a retainer and
        hoping it pays off &mdash; you pay when qualified conversations actually
        reach your calendar. We take the risk, because we&rsquo;re confident in
        the system. If it doesn&rsquo;t produce, you don&rsquo;t pay for it.
      </p>
    </div>
  </section>

  <!-- How it works teaser -->
  <section class="section">
    <div class="container">
      <div class="section-head is-center">
        <p class="eyebrow">How it works</p>
        <h2>A system built and run for your agency.</h2>
        <p>
          Not a course, not software you have to figure out yourself. We handle
          the infrastructure, the messaging, and the outreach &mdash; you take
          the calls.
        </p>
      </div>

      <div class="grid grid-3">
        <article class="card">
          <span class="step-num">01</span>
          <h3>We build the infrastructure</h3>
          <p>
            Dedicated sending infrastructure, kept separate from your primary
            domain so your brand and deliverability stay protected.
          </p>
        </article>
        <article class="card">
          <span class="step-num">02</span>
          <h3>We run candidate-led outreach</h3>
          <p>
            MPC messaging and hiring-intent lists, positioned for your niche, so
            the right hiring managers hear from you.
          </p>
        </article>
        <article class="card">
          <span class="step-num">03</span>
          <h3>Qualified calls reach you</h3>
          <p>
            We handle replies and qualification. Only booked, relevant
            conversations land on your calendar.
          </p>
        </article>
      </div>

      <div class="center-cta">
        <a href="/how-it-works" class="btn btn-outline">Read the full methodology</a>
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What&rsquo;s included</p>
        <h2>Done-for-you, end to end.</h2>
      </div>
      <ul class="deliverables">
        <li>Outbound infrastructure setup and deliverability management</li>
        <li>MPC-led messaging and offer positioning for your niche</li>
        <li>Hiring-intent lists sourced and refreshed weekly</li>
        <li>Reply handling and qualification, so only booked calls reach you</li>
        <li>Performance-based, pay-on-results pricing</li>
      </ul>
    </div>
  </section>

  <!-- Who we are teaser -->
  <section class="section">
    <div class="container who">
      <div class="who-copy">
        <p class="eyebrow">Who we are</p>
        <h2>A small team, working with a handful of agencies at a time.</h2>
        <p>
          We deliberately keep our roster small so every campaign gets built and
          run properly. We&rsquo;re early, we&rsquo;re selective about who we work
          with, and we&rsquo;d rather do a few things exceptionally than many
          things adequately.
        </p>
        <a href="/about" class="btn btn-outline">Meet the team</a>
      </div>
      <!-- [PLACEHOLDER] Swap for a real team photo -->
      <div class="who-photo" role="img" aria-label="Team photo placeholder">
        <span>[ Team photo &mdash; placeholder ]</span>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container final-cta-inner">
      <h2>See whether we&rsquo;re a fit.</h2>
      <p>
        A low-pressure call to understand your agency, your niche, and whether a
        pay-on-results model makes sense for you. No hard sell.
      </p>
      <a href="/book" class="btn btn-primary btn-lg">Book a call</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .hero h1 {
    max-width: 18ch;
    margin: 0 auto;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .hero .eyebrow {
    text-align: center;
  }

  .hero-lede {
    max-width: 640px;
    margin: 1.3rem auto 0;
    color: var(--text-muted);
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  /* Risk band */
  .risk {
    padding: 4rem 0;
  }

  .risk-inner {
    max-width: 720px;
    text-align: center;
  }

  .risk h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .risk p {
    margin: 1.1rem auto 0;
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.65;
  }

  /* Step cards */
  .step-num {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--number-color);
    font-family: var(--font-display, "Clash Grotesk", system-ui, sans-serif);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .center-cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  /* Deliverables */
  .deliverables {
    max-width: 720px;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .deliverables li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .deliverables li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
  }

  /* Who */
  .who {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .who-copy h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .who-copy p {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .who-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--accent-border);
    border-radius: 1rem;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* Final CTA */
  .final-cta {
    padding: 5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .final-cta-inner {
    max-width: 620px;
    text-align: center;
  }

  .final-cta h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 700;
  }

  .final-cta p {
    margin: 1rem auto 2rem;
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  @media (min-width: 860px) {
    .who {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.5rem;
    }
  }
</style>
