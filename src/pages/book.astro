---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Book a Call | Furum Consulting"
  description="Book a low-pressure call with Furum Consulting to see whether pay-on-results client acquisition fits your recruiting agency."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Book a call</p>
      <h1>See whether we&rsquo;re a fit.</h1>
      <p>
        A low-pressure conversation to understand your agency, your niche, and
        whether a pay-on-results model makes sense for you. Watch the short
        overview below, then pick a time.
      </p>
    </div>
  </section>

  <!-- Overview video -->
  <section class="section--tight">
    <div class="container">
      <div class="video-head">
        <p class="eyebrow">A 2-minute overview</p>
        <p class="video-sub">How the system works and who it&rsquo;s for, from our founders.</p>
      </div>
      <div class="video-frame shadow-medium">
        <div id="vidalytics_embed_8GoihHVYaY4zw8qH" style="width: 100%; position: relative; padding-top: 56.25%;"></div>
      </div>
    </div>
  </section>

  <!-- Booking -->
  <section id="book" class="section section--alt">
    <div class="container">
      <div class="section-head is-center">
        <p class="eyebrow">Pick a time</p>
        <h2>Schedule your discovery call.</h2>
        <p>No hard sell. We&rsquo;ll be straight with you about whether this is a fit for your agency.</p>
      </div>
      <div class="calendar-card shadow-medium">
        <div id="cal-embed" class="cal-embed"></div>
      </div>
    </div>
  </section>

  <!-- What you'll learn -->
  <section class="section">
    <div class="container">
      <div class="section-head is-center">
        <p class="eyebrow">On the call</p>
        <h2>What we&rsquo;ll cover.</h2>
      </div>
      <div class="grid grid-3">
        <article class="card">
          <span class="learn-num">01</span>
          <h3>Whether you&rsquo;re a fit</h3>
          <p>If your niche and candidate bench support a pay-on-results model &mdash; and if not, we&rsquo;ll tell you.</p>
        </article>
        <article class="card">
          <span class="learn-num">02</span>
          <h3>How the system is built</h3>
          <p>How the infrastructure, MPC messaging, and lists would be set up for your specific market.</p>
        </article>
        <article class="card">
          <span class="learn-num">03</span>
          <h3>What to expect</h3>
          <p>A realistic view of pipeline and timeline &mdash; groundwork first, then ramp. No overnight promises.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Illustrative model -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head is-center">
        <p class="eyebrow">An illustrative model</p>
        <h2>Sketch out the numbers.</h2>
        <p>
          A rough model based on conservative campaign benchmarks &mdash; not a
          promise of results. Plug in your own figures to see the shape of it.
        </p>
      </div>

      <div class="calc-panel">
        <div class="calc-inputs">
          <div class="calc-field">
            <label for="calc-revenue">
              Average revenue per client in the first year
              <output id="calc-revenue-out">$30,000</output>
            </label>
            <input id="calc-revenue" type="range" min="5000" max="150000" step="1000" value="30000" />
          </div>
          <div class="calc-field">
            <label for="calc-close">
              Close rate from calls
              <output id="calc-close-out">20%</output>
            </label>
            <input id="calc-close" type="range" min="5" max="50" step="1" value="20" />
          </div>
        </div>

        <div class="calc-results" aria-live="polite">
          <div class="calc-result">
            <p>New clients / month</p>
            <strong id="calc-clients">2.1</strong>
          </div>
          <div class="calc-result">
            <p>New client revenue / month</p>
            <strong id="calc-revenue-result">$63,360</strong>
          </div>
        </div>

        <p class="calc-note">
          Illustrative only. Figures are modelled on conservative benchmarks and
          will vary by niche, offer, and market. We&rsquo;ll give you realistic,
          specific expectations on the call.
        </p>
      </div>
    </div>
  </section>

  <script is:inline type="text/javascript">
    (function (v, i, d, a, l, y, t, c, s) {
      y = '_' + d.toLowerCase(); c = d + 'L'; if (!v[d]) { v[d] = {}; } if (!v[c]) { v[c] = {}; } if (!v[y]) { v[y] = {}; } var vl = 'Loader', vli = v[y][vl], vsl = v[c][vl + 'Script'], vlf = v[c][vl + 'Loaded'], ve = 'Embed';
      if (!vsl) {
        vsl = function (u, cb) {
          if (t) { cb(); return; } s = i.createElement("script"); s.type = "text/javascript"; s.async = 1; s.src = u;
          if (s.readyState) { s.onreadystatechange = function () { if (s.readyState === "loaded" || s.readyState == "complete") { s.onreadystatechange = null; vlf = 1; cb(); } }; } else { s.onload = function () { vlf = 1; cb(); }; }
          i.getElementsByTagName("head")[0].appendChild(s);
        };
      }
      vsl(l + 'loader.min.js', function () { if (!vli) { var vlc = v[c][vl]; vli = new vlc(); } vli.loadScript(l + 'player.min.js', function () { var vec = v[d][ve]; t = new vec(); t.run(a); }); });
    })(window, document, 'Vidalytics', 'vidalytics_embed_8GoihHVYaY4zw8qH', 'https://fast.vidalytics.com/embeds/2rtPO8Ua/8GoihHVYaY4zw8qH/');
  </script>

  <script>
    (function (C: any, A: string, L: string) {
      const p = function (a: any, ar: IArguments) {
        a.q.push(ar);
      };
      const d = C.document;
      C.Cal = C.Cal || function () {
        const cal = C.Cal;
        const ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else {
            p(cal, ar);
          }
          return;
        }
        p(cal, ar);
      };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    (window as any).Cal("init", "discovery-call", { origin: "https://app.cal.com" });
    (window as any).Cal.ns["discovery-call"]("inline", {
      elementOrSelector: "#cal-embed",
      calLink: "furumconsulting/discovery-call",
      config: {
        theme: "light",
        layout: "month_view"
      }
    });
    (window as any).Cal.ns["discovery-call"]("ui", {
      theme: "light",
      styles: {
        branding: {
          brandColor: "#2d5d52"
        }
      },
      hideEventTypeDetails: false
    });
  </script>

  <script>
    // Illustrative ROI model. Volume and pricing are fixed internally, not rendered.
    // Pricing model: base fee + 2% of avg first-year client revenue per show.
    const EMAILS_PER_DAY = 1000;
    const SENDING_DAYS = 22;
    const REPLY_RATE = 0.015;
    const POSITIVE_RATE = 0.1;
    const BOOK_RATE = 0.4;
    const SHOW_RATE = 0.8;

    const revenueInput = document.getElementById("calc-revenue") as HTMLInputElement | null;
    const closeInput = document.getElementById("calc-close") as HTMLInputElement | null;
    const revenueOut = document.getElementById("calc-revenue-out") as HTMLOutputElement | null;
    const closeOut = document.getElementById("calc-close-out") as HTMLOutputElement | null;
    const clientsEl = document.getElementById("calc-clients");
    const revenueResultEl = document.getElementById("calc-revenue-result");

    function update() {
      if (!revenueInput || !closeInput) return;
      const avgRevenue = Number(revenueInput.value);
      const closeRate = Number(closeInput.value) / 100;

      const emails = EMAILS_PER_DAY * SENDING_DAYS;
      const shows = emails * REPLY_RATE * POSITIVE_RATE * BOOK_RATE * SHOW_RATE;
      const clients = shows * closeRate;
      const revenue = clients * avgRevenue;

      if (revenueOut) revenueOut.textContent = `$${avgRevenue.toLocaleString("en-US")}`;
      if (closeOut) closeOut.textContent = `${closeInput.value}%`;
      if (clientsEl) clientsEl.textContent = clients.toFixed(1);
      if (revenueResultEl) revenueResultEl.textContent = `$${Math.round(revenue).toLocaleString("en-US")}`;
    }

    revenueInput?.addEventListener("input", update);
    closeInput?.addEventListener("input", update);
    update();
  </script>
</Layout>

<style>
  .video-head {
    max-width: 720px;
    margin: 0 auto 1.5rem;
    text-align: center;
  }

  .video-head .eyebrow {
    margin-bottom: 0.4rem;
  }

  .video-sub {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
  }

  .video-frame {
    max-width: 720px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface2);
  }

  .calendar-card {
    max-width: 900px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--accent-border);
    border-radius: 1rem;
    background: var(--page-bg);
  }

  .cal-embed {
    width: 100%;
    min-height: 680px;
  }

  .learn-num {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--number-color);
    font-family: var(--font-display, "Clash Grotesk", system-ui, sans-serif);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.12rem;
    font-weight: 700;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Illustrative model */
  .calc-panel {
    max-width: 820px;
    margin: 0 auto;
    padding: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 1.1rem;
    background: var(--page-bg);
  }

  .calc-inputs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  .calc-field label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .calc-field output {
    color: var(--accent);
    font-family: var(--font-display, "Clash Grotesk", system-ui, sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .calc-field input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .calc-results {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .calc-result {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    background: var(--surface);
    text-align: center;
  }

  .calc-result p {
    margin: 0 0 0.4rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .calc-result strong {
    color: var(--text-primary);
    font-family: var(--font-display, "Clash Grotesk", system-ui, sans-serif);
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1;
  }

  .calc-note {
    max-width: 620px;
    margin: 1.75rem auto 0;
    color: var(--text-dim);
    font-size: 0.82rem;
    line-height: 1.55;
    text-align: center;
  }

  @media (min-width: 720px) {
    .calc-inputs { grid-template-columns: 1fr 1fr; }
    .calc-results { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .cal-embed { min-height: 720px; }
  }
</style>
